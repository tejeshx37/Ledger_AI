# Copy to .env and fill in real values. Never commit a real .env file.
# Every variable here maps to a Settings field via LEDGER__<SECTION>__<FIELD>
# (see src/ledger/config/settings.py). No default in configs/*.yaml
# contains a credential — secrets only ever come from the environment.

LEDGER__DATABASE__DSN=postgresql+psycopg2://ledger:changeme@localhost:5432/ledger
LEDGER__SERVING__PORT=8000
LEDGER__LOGGING__LEVEL=INFO
LEDGER__LOGGING__JSON_FORMAT=false

# Boundary-node embedding pseudonymisation key for the federated protocol
# (Phase 5.2). Must be shared out-of-band between simulated banks, never
# committed.
LEDGER_BOUNDARY_HASH_KEY=changeme

# Optional LLM narrative-refinement layer (Phase 6.3). Leave unset to run
# with provider=null (deterministic narratives only, the default).
LEDGER__LLM__PROVIDER=null
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=ledger
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ledger
